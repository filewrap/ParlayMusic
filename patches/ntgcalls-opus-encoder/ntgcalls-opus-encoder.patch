new file mode 100644
index 0000000..c579581
--- /dev/null
+++ b/ntgcalls/src/opus_encoder_config_c.cpp
@@ -0,0 +1,78 @@
+// Parlay patch (OD-1): C API for the locked Opus encoder configuration.
+// Hand-written (not NTL-generated); see targets/c/ntgcalls_opus.h.
+
+#include "ntgcalls.h"
+#include "ntgcalls_opus.h"
+
+#include <wrtc/interfaces/media/opus_encoder_factory.hpp>
+
+namespace {
+
+wrtc::interfaces::media::OpusEncoderSettings ToCpp(
+    const ntg_opus_encoder_config& c) {
+    wrtc::interfaces::media::OpusEncoderSettings s;
+    s.bitrate_bps = c.bitrate_bps;
+    s.complexity = c.complexity;
+    s.vbr_enabled = c.vbr_enabled;
+    s.fec_enabled = c.fec_enabled;
+    s.dtx_enabled = c.dtx_enabled;
+    s.frame_size_ms = c.frame_size_ms;
+    s.max_playback_rate_hz = c.max_playback_rate_hz;
+    return s;
+}
+
+ntg_opus_encoder_config FromCpp(
+    const wrtc::interfaces::media::OpusEncoderSettings& s) {
+    ntg_opus_encoder_config c{};
+    c.bitrate_bps = s.bitrate_bps;
+    c.complexity = s.complexity;
+    c.vbr_enabled = s.vbr_enabled;
+    c.fec_enabled = s.fec_enabled;
+    c.dtx_enabled = s.dtx_enabled;
+    c.frame_size_ms = s.frame_size_ms;
+    c.max_playback_rate_hz = s.max_playback_rate_hz;
+    return c;
+}
+
+bool ValidFrameSize(int32_t ms) {
+    return ms == 10 || ms == 20 || ms == 40 || ms == 60;
+}
+
+} // namespace
+
+extern "C" {
+
+NTG_C_EXPORT ntg_result ntg_opus_set_config(const ntg_opus_encoder_config* config) {
+    if (config == nullptr) {
+        return NTG_ERR_NULL_POINTER;
+    }
+    if (config->bitrate_bps < 6000 || config->bitrate_bps > 510000 ||
+        config->complexity < 0 || config->complexity > 10 ||
+        !ValidFrameSize(config->frame_size_ms) ||
+        config->max_playback_rate_hz < 8000 ||
+        config->max_playback_rate_hz > 48000) {
+        return NTG_ERR_INVALID_PARAMS;
+    }
+    wrtc::interfaces::media::OpusEncoderFactory::SetSettings(ToCpp(*config));
+    return NTG_OK;
+}
+
+NTG_C_EXPORT ntg_result ntg_opus_get_config(ntg_opus_encoder_config* out) {
+    if (out == nullptr) {
+        return NTG_ERR_NULL_POINTER;
+    }
+    *out = FromCpp(wrtc::interfaces::media::OpusEncoderFactory::GetSettings());
+    return NTG_OK;
+}
+
+NTG_C_EXPORT ntg_result ntg_opus_set_bitrate(int32_t bitrate_bps) {
+    if (bitrate_bps < 6000 || bitrate_bps > 510000) {
+        return NTG_ERR_INVALID_PARAMS;
+    }
+    auto settings = wrtc::interfaces::media::OpusEncoderFactory::GetSettings();
+    settings.bitrate_bps = bitrate_bps;
+    wrtc::interfaces::media::OpusEncoderFactory::SetSettings(settings);
+    return NTG_OK;
+}
+
+} // extern "C"
