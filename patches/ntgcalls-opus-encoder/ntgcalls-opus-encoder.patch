diff --git a/wrtc/src/interfaces/media/opus_encoder_factory.cpp b/wrtc/src/interfaces/media/opus_encoder_factory.cpp
new file mode 100644
index 0000000..01fb5af
--- /dev/null
+++ b/wrtc/src/interfaces/media/opus_encoder_factory.cpp
@@ -0,0 +1,111 @@
+// Parlay patch (OD-1): Opus encoder configuration for music playback.
+// See the header for the design and the OPUS_SIGNAL_MUSIC deviation note.
+
+#include <wrtc/interfaces/media/opus_encoder_factory.hpp>
+
+#include <algorithm>
+#include <mutex>
+
+#include <absl/strings/match.h>
+#include <api/audio_codecs/opus/audio_encoder_opus_config.h>
+#include <modules/audio_coding/codecs/opus/audio_encoder_opus.h>
+#include <rtc_base/checks.h>
+
+namespace wrtc::interfaces::media {
+
+namespace {
+
+std::mutex g_settings_mutex;
+OpusEncoderSettings g_settings;
+
+OpusEncoderSettings ClampSettings(const OpusEncoderSettings& in) {
+    OpusEncoderSettings out = in;
+    out.bitrate_bps = std::clamp<int32_t>(
+        out.bitrate_bps,
+        webrtc::AudioEncoderOpusConfig::kMinBitrateBps,
+        webrtc::AudioEncoderOpusConfig::kMaxBitrateBps);
+    out.complexity = std::clamp<int32_t>(out.complexity, 0, 10);
+    // Only frame sizes WebRTC's Opus encoder supports (see
+    // AudioEncoderOpusConfig::IsOk / kOpusSupportedFrameLengths).
+    if (out.frame_size_ms != 10 && out.frame_size_ms != 20 &&
+        out.frame_size_ms != 40 && out.frame_size_ms != 60) {
+        out.frame_size_ms = 20;
+    }
+    if (out.max_playback_rate_hz < 8000 ||
+        out.max_playback_rate_hz > 48000) {
+        out.max_playback_rate_hz = 48000;
+    }
+    return out;
+}
+
+} // namespace
+
+OpusEncoderFactory::OpusEncoderFactory(
+    webrtc::scoped_refptr<webrtc::AudioEncoderFactory> fallback)
+    : fallback_(std::move(fallback)) {}
+
+std::vector<webrtc::AudioCodecSpec> OpusEncoderFactory::GetSupportedEncoders() {
+    return fallback_->GetSupportedEncoders();
+}
+
+std::optional<webrtc::AudioCodecInfo> OpusEncoderFactory::QueryAudioEncoder(
+    const webrtc::SdpAudioFormat& format) {
+    return fallback_->QueryAudioEncoder(format);
+}
+
+std::unique_ptr<webrtc::AudioEncoder> OpusEncoderFactory::Create(
+    const webrtc::Environment& env,
+    const webrtc::SdpAudioFormat& format,
+    Options options) {
+    // Only Opus goes through the locked config; everything else is the
+    // builtin factory's job. SdpToConfig rejects non-48kHz / non-stereo
+    // formats, so mirror that gate here (num_channels 1-2; the negotiated
+    // Telegram group-call format is opus/48000/2).
+    if (!absl::EqualsIgnoreCase(format.name, "opus") ||
+        format.clockrate_hz != 48000 ||
+        (format.num_channels != 1 && format.num_channels != 2)) {
+        return fallback_->Create(env, format, options);
+    }
+
+    const OpusEncoderSettings settings = GetSettings();
+
+    webrtc::AudioEncoderOpusConfig config;
+    config.frame_size_ms = settings.frame_size_ms;
+    config.sample_rate_hz = format.clockrate_hz;
+    config.num_channels = format.num_channels;
+    // Locked: music, always. (SdpToConfig would derive kVoip for mono;
+    // the lock has no VoIP mode.)
+    config.application =
+        webrtc::AudioEncoderOpusConfig::ApplicationMode::kAudio;
+    config.bitrate_bps = settings.bitrate_bps;
+    config.fec_enabled = settings.fec_enabled;
+    // VBR on means CBR off.
+    config.cbr_enabled = !settings.vbr_enabled;
+    config.max_playback_rate_hz = settings.max_playback_rate_hz;
+    config.complexity = settings.complexity;
+    // Keep complexity at the locked value even if the bitrate later drops
+    // below the WebRTC low-rate threshold (GetNewComplexity switches to
+    // low_rate_complexity under ~12.5 kbps).
+    config.low_rate_complexity = settings.complexity;
+    config.dtx_enabled = settings.dtx_enabled;
+    config.supported_frame_lengths_ms = {20, 40, 60};
+    RTC_DCHECK(config.IsOk());
+
+    // Public constructor (M152): builds the encoder with the config above;
+    // RecreateEncoderInstance applies OPUS_SET_APPLICATION(AUDIO),
+    // OPUS_SET_BITRATE, OPUS_SET_COMPLEXITY, OPUS_SET_VBR, OPUS_SET_INBAND_FEC.
+    return std::make_unique<webrtc::AudioEncoderOpusImpl>(
+        env, std::move(config), options.payload_type);
+}
+
+OpusEncoderSettings OpusEncoderFactory::GetSettings() {
+    const std::lock_guard lock(g_settings_mutex);
+    return g_settings;
+}
+
+void OpusEncoderFactory::SetSettings(const OpusEncoderSettings& settings) {
+    const std::lock_guard lock(g_settings_mutex);
+    g_settings = ClampSettings(settings);
+}
+
+} // namespace wrtc::interfaces::media
