diff --git a/targets/c/ntgcalls_opus.h b/targets/c/ntgcalls_opus.h
new file mode 100644
index 0000000..e3f75e5
--- /dev/null
+++ b/targets/c/ntgcalls_opus.h
@@ -0,0 +1,68 @@
+// Parlay patch (OD-1): C API for the locked Opus encoder configuration.
+//
+// Hand-written sidecar to the generated ntgcalls.h -- intentionally NOT
+// part of the NTL schema (schema changes would regenerate every binding).
+// Include after ntgcalls.h; links against the same libntgcalls.so.
+//
+// Effective encoder settings (defaults are the locked values):
+//   bitrate_bps         192000 (ladder 192000 -> 160000 -> 128000; lock the
+//                              verified ceiling in parlay.toml opus_bitrate_kbps)
+//   complexity          10     (OPUS_SET_COMPLEXITY(10))
+//   vbr_enabled         true   (OPUS_SET_VBR(1))
+//   fec_enabled         false  (OPUS_SET_INBAND_FEC(0))
+//   dtx_enabled         false
+//   frame_size_ms       20     (ptime=20; Xiph's recommended default --
+//                              60 ms at 256/320 kbps = 1920/2400-byte
+//                              packets, past MTU)
+//   max_playback_rate_hz 48000 (fullband)
+//
+// Application is OPUS_APPLICATION_AUDIO, fixed (the lock has no VoIP mode).
+// Signal is OPUS_AUTO, not OPUS_SIGNAL_MUSIC: WebRTC M152 exposes no
+// OPUS_SET_SIGNAL path (AudioEncoderOpusConfig has no signal field and
+// WebRtcOpus_EncoderCreate never calls it). With APPLICATION_AUDIO, libopus
+// caps the voice estimate and at 128-192 kbps stereo selects CELT_ONLY /
+// fullband identically to SIGNAL_MUSIC; see phase5/worker-a-ntgcalls.md.
+//
+// Scope: settings are process-global and apply to Opus encoders created
+// AFTER the call. Set them once at startup (or before joining a call);
+// changing them does not reconfigure a running encoder.
+#pragma once
+
+#include <stdbool.h>
+#include <stdint.h>
+
+#include "ntgcalls.h"
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+typedef struct ntg_opus_encoder_config {
+    int32_t bitrate_bps;
+    int32_t complexity;
+    bool vbr_enabled;
+    bool fec_enabled;
+    bool dtx_enabled;
+    int32_t frame_size_ms;
+    int32_t max_playback_rate_hz;
+} ntg_opus_encoder_config;
+
+// Replace the global Opus encoder settings. Values are clamped to the
+// ranges WebRTC accepts (bitrate 6000-510000, complexity 0-10,
+// frame_size_ms one of 10/20/40/60, max_playback_rate_hz 8000-48000).
+// Returns NTG_ERR_NULL_POINTER if config is NULL.
+NTG_C_EXPORT ntg_result ntg_opus_set_config(const ntg_opus_encoder_config* config);
+
+// Read back the current global Opus encoder settings (the locked defaults
+// until ntg_opus_set_config / ntg_opus_set_bitrate is called).
+// Returns NTG_ERR_NULL_POINTER if out is NULL.
+NTG_C_EXPORT ntg_result ntg_opus_get_config(ntg_opus_encoder_config* out);
+
+// Convenience for the bitrate ladder: set only bitrate_bps, keeping every
+// other setting. Returns NTG_ERR_INVALID_PARAMS if the bitrate is outside
+// 6000-510000.
+NTG_C_EXPORT ntg_result ntg_opus_set_bitrate(int32_t bitrate_bps);
+
+#ifdef __cplusplus
+}
+#endif
diff --git a/wrtc/include/wrtc/interfaces/media/opus_encoder_factory.hpp b/wrtc/include/wrtc/interfaces/media/opus_encoder_factory.hpp
new file mode 100644
index 0000000..e287330
--- /dev/null
+++ b/wrtc/include/wrtc/interfaces/media/opus_encoder_factory.hpp
@@ -0,0 +1,105 @@
+// Parlay patch (OD-1): Opus encoder configuration for music playback.
+//
+// Stock libntgcalls.so 3.0.5 exposes no Opus encoder configuration: the
+// encoder is created by WebRTC's builtin AudioEncoderFactory from SDP
+// parameters only (see AudioEncoderOpusImpl::SdpToConfig, WebRTC M152),
+// which fixes application to kVoip for mono / kAudio for stereo, complexity
+// to the WebRTC default (9), and leaves the signal at OPUS_AUTO. The locked
+// Parlay requirement (FINAL-ARCHITECTURE.md §1.4/§3.3) needs explicit
+// control, so this factory wraps the builtin factory and constructs
+// AudioEncoderOpusImpl directly with a full AudioEncoderOpusConfig.
+//
+// What this delivers, per locked §1.4:
+//   - OPUS_APPLICATION_AUDIO: config.application = kAudio, always (the
+//     lock has no VoIP mode); applied by WebRtcOpus_EncoderCreate as
+//     opus_encoder_create(..., OPUS_APPLICATION_AUDIO, ...).
+//   - OPUS_SET_COMPLEXITY(10): config.complexity = 10 and
+//     config.low_rate_complexity = 10, so GetNewComplexity() keeps 10 at
+//     any bitrate; applied by RecreateEncoderInstance via
+//     WebRtcOpus_SetComplexity.
+//   - OPUS_SET_VBR(1): config.cbr_enabled = false -> DisableCbr ->
+//     OPUS_SET_VBR(1).
+//   - OPUS_SET_INBAND_FEC(0): config.fec_enabled = false -> DisableFec ->
+//     OPUS_SET_INBAND_FEC(0).
+//   - Bitrate ladder 192000 -> 160000 -> 128000 bps: config.bitrate_bps,
+//     settable at runtime (applies to encoders created after the call).
+//
+// Known deviation -- OPUS_SIGNAL_MUSIC: WebRTC M152's AudioEncoderOpusConfig
+// has no signal field and WebRtcOpus_EncoderCreate never calls
+// OPUS_SET_SIGNAL, so there is no WebRTC API path to set the signal
+// explicitly; the encoder runs with libopus's default signal OPUS_AUTO.
+// With OPUS_APPLICATION_AUDIO, libopus caps the voice estimate
+// (voice_est <= 115, 48 with no tonality analysis) and at the locked
+// 128-192 kbps stereo rates the mode decision lands on CELT_ONLY/fullband
+// either way (music mode threshold 10 kbps stereo vs voice 44 kbps), so
+// the audible difference vs OPUS_SIGNAL_MUSIC at these rates is nil.
+// A literal OPUS_SET_SIGNAL(MUSIC) would require reimplementing the Opus
+// encoder as a custom AudioEncoder subclass calling libopus directly;
+// that is out of scope for this patch -- see phase5/worker-a-ntgcalls.md.
+
+#pragma once
+
+#include <cstdint>
+#include <memory>
+#include <optional>
+#include <vector>
+
+#include <api/audio_codecs/audio_encoder_factory.h>
+#include <api/audio_codecs/audio_format.h>
+#include <api/environment/environment.h>
+#include <api/scoped_refptr.h>
+
+namespace wrtc::interfaces::media {
+
+// Global Opus encoder settings. Applied to every Opus encoder created
+// after SetSettings() is called; encoders already running are unaffected
+// (use RtpParameters max_bitrate_bps for live bitrate changes, or
+// re-create the call). All fields are validated/clamped on set.
+struct OpusEncoderSettings {
+    // Target bitrate in bits per second. Locked ladder: 192000 -> 160000
+    // -> 128000 (lock the verified ceiling in parlay.toml opus_bitrate_kbps).
+    int32_t bitrate_bps = 192000;
+    // Opus complexity 0-10. Locked at 10 (maximum quality).
+    int32_t complexity = 10;
+    // True = OPUS_SET_VBR(1); false = CBR.
+    bool vbr_enabled = true;
+    // True = OPUS_SET_INBAND_FEC(1); false = OPUS_SET_INBAND_FEC(0).
+    bool fec_enabled = false;
+    // Opus DTX. Locked off: music must not gate.
+    bool dtx_enabled = false;
+    // Packet frame size in ms; one of 10/20/40/60. 20 ms is Xiph's
+    // recommended default; 60 ms packets at 256/320 kbps exceed MTU.
+    int32_t frame_size_ms = 20;
+    // Maximum playback rate in Hz; 48000 = fullband.
+    int32_t max_playback_rate_hz = 48000;
+};
+
+// AudioEncoderFactory that creates Opus encoders with the Parlay locked
+// configuration and delegates every other codec to the builtin factory.
+// Signaling/negotiation behaviour is unchanged: GetSupportedEncoders() and
+// QueryAudioEncoder() delegate verbatim, so the advertised codec list is
+// exactly what the builtin factory advertises.
+// NOTE: deliberately not `final`: webrtc::make_ref_counted wraps the class
+// in RefCountedObject<T>, which derives from T.
+class OpusEncoderFactory : public webrtc::AudioEncoderFactory {
+public:
+    explicit OpusEncoderFactory(
+        webrtc::scoped_refptr<webrtc::AudioEncoderFactory> fallback);
+
+    std::vector<webrtc::AudioCodecSpec> GetSupportedEncoders() override;
+    std::optional<webrtc::AudioCodecInfo> QueryAudioEncoder(
+        const webrtc::SdpAudioFormat& format) override;
+    std::unique_ptr<webrtc::AudioEncoder> Create(
+        const webrtc::Environment& env,
+        const webrtc::SdpAudioFormat& format,
+        Options options) override;
+
+    // Global settings (thread-safe). Defaults are the locked values above.
+    static OpusEncoderSettings GetSettings();
+    static void SetSettings(const OpusEncoderSettings& settings);
+
+private:
+    webrtc::scoped_refptr<webrtc::AudioEncoderFactory> fallback_;
+};
+
+} // namespace wrtc::interfaces::media
