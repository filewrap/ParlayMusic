# Parlay — copy to .env and fill in locally. Never commit .env.
# Every variable the code reads, one line each (verified by grepping the
# tree, 2026-11-03, Phase 5 Worker E — re-verified after the scope
# update: 77 vars read in code, all covered; the only extras are the 2
# LEGACY vars below, kept so old deploys fail loudly instead of silently).
# Removed dead vars: VC_ENGINE (never read anywhere), NAVIDROME_PASS
# (code reads NAVIDROME_PASSWORD).
# Compose sets PORT / PARLAY_DATA_DIR / PARLAY_DL_DIR per service; the
# values below are the local-run defaults.

# --- Telegram bot (core-cpp, required) ---
BOT_TOKEN=  # Bot API token from @BotFather (required to start)
API_ID=  # Telegram API id (Bot API + MTProto; TD_API_ID falls back to this)
API_HASH=  # Telegram API hash (TD_API_HASH falls back to this)
OWNER_ID=  # Telegram user id of the owner (permission model)
SUDO_IDS=  # comma-separated sudo user ids
LOGGER_ID=  # log channel/chat id (0 = unset)
PARLAY_ALLOW_CHATS=  # comma-separated chat ids the bot serves (empty = all)
PARLAY_BLOCK_CHATS=  # comma-separated chat ids the bot refuses
ASSISTANT_IDS=  # comma-separated assistant/userbot account ids
SUPPORT_CHAT=  # support chat shown in /help (e.g. @parlay_support)

# --- Shared IPC auth (all 12 services, same value everywhere) ---
PARLAY_TOKEN=  # X-Parlay-Token header value (required to start core; empty = auth off, dev only)

# --- State (core-cpp + vc-go) ---
MONGO_URI=mongodb://localhost:27017/parlay  # core + vc-go queues/settings (compose: mongodb://mongo:27017/parlay)
REDIS_URL=redis://localhost:6379/0  # core now-playing mirror, rate limits (compose: redis://redis:6379/0)

# --- Service URLs (core-cpp; defaults already match docker-compose.yml) ---
VC_GO_URL=http://vc-go:8001  # Go VC engine (local: http://localhost:8001)
VC_TS_URL=http://vc-ts:8002  # TS VC engine (local: http://localhost:8002)
VC_RUST_URL=http://vc-rust:8003  # Rust VC engine (local: http://localhost:8003)
FX_URL=http://audio-fx-rust:8004  # audio FX (local: http://localhost:8004; code default port is 8003, compose sets PORT=8004)
SHARE_URL=http://share-rust:8005  # anonymous shares (local: http://localhost:8005; code default 8004, compose sets PORT=8005)
QUEUE_URL=http://queue-rust:8006  # voting queue (local: http://localhost:8006; code default 8005, compose sets PORT=8006)
SPOTIFY_URL=http://spotify-rust:8007  # Spotify watch/classifier (local: http://localhost:8007)
RADIO_URL=http://radio-js:8008  # radio (local: http://localhost:8008)
DL_URL=http://downloaders:8009  # downloaders (local: http://localhost:8009; code default port is 8010, compose sets PORT=8009; alias DOWNLOADERS_URL also read, DL_URL wins)
DOWNLOADERS_URL=http://downloaders:8009  # alias for DL_URL (kept for backwards compatibility)
NETEASE_URL=http://netease-go:8010  # NetEase (local: http://localhost:8010)
CORE_URL=http://core-cpp:8080  # gui-js: core base URL for now-playing/queue proxy (local: http://localhost:8080)

# --- Ports / data dirs (compose sets these per service; local defaults) ---
PORT=8080  # per-service listen port: core 8080, vc-go 8001, vc-ts 8002, vc-rust 8003, audio-fx 8004, share 8005, queue 8006, spotify 8007, radio 8008, downloaders 8009, netease 8010, gui 3000
PARLAY_DATA_DIR=data  # JSON-file state dir (core default "data", others "./data"; compose: /data/<service>)
PARLAY_DL_DIR=./downloads  # download dir (downloaders default ./downloads; netease-go default ./data; compose: /data/downloads and /data/netease)
PARLAY_LOG_FILE=  # core-cpp: optional stdout/stderr tee file (empty = off)
PARLAY_LIVE_TEST=  # set to 1 to run live (network) tests; offline tests run by default

# --- Voice backends (core-cpp; TDLib is the live-join route) ---
TD_API_ID=  # TDLib api id (falls back to API_ID)
TD_API_HASH=  # TDLib api hash (falls back to API_HASH)
TD_SESSION_DIR=  # TDLib database dir (pre-authorized assistant session lives here)
TDJSON_LIB=  # explicit libtdjson.so path (default: phase4 build output; empty = dlopen search)
NTGCALLS_LIB=  # explicit libntgcalls.so path (empty = dlopen search; absent = voice unavailable, honestly)
TD_PHONE=  # TDLib first-auth phone, only if a fresh login is needed
TD_CODE=  # TDLib first-auth login code
TD_PASSWORD=  # TDLib first-auth 2FA password
TD_EMAIL=  # TDLib first-auth email, only if the account uses email login
TD_EMAIL_CODE=  # TDLib email login code
TD_FIRST_NAME=  # TDLib first-time registration first name (required if registering)
TD_LAST_NAME=  # TDLib first-time registration last name (optional)
TD_QR=1  # set to 1 to use QR-code login instead of phone+code on first auth
VOICE_RTP_SINK=  # host:port UDP sink for the Opus/RTP pipeline proof (empty = file only)
PARLAY_VOICE_PYTHON=python3  # python binary for vc-rust/vc-ts voice helpers (ntg_offer.py)
TELEGRAM_API_BASE=https://api.telegram.org  # Bot API base (override for a local Bot API server)

# --- Playback limits (core-cpp) ---
DURATION_LIMIT=60  # max track length, minutes
QUEUE_LIMIT=20  # max queued tracks per chat

# --- VC engines ---
VC_PROFILE=low-ram  # vc-go: low-ram | high-perf
YT_DLP=  # yt-dlp binary path (vc-ts + vc-rust; empty = `yt-dlp` on PATH, else downloaders venv)

# --- Spotify (spotify-rust + downloaders + vc-ts) ---
SPOTIFY_CLIENT_ID=  # Spotify app client id (metadata, collections, per-user OAuth)
SPOTIFY_CLIENT_SECRET=  # Spotify app client secret
SPOTIFY_REDIRECT_URI=http://localhost:8080/callback  # per-user OAuth redirect (spotify-rust auth)
SPOTIFY_ACCOUNTS_URL=https://accounts.spotify.com  # Spotify accounts base (override for tests)
SPOTIFY_API_BASE=https://api.spotify.com  # Spotify Web API base (override for tests)
SPOTIFY_POLL_INTERVAL_SECS=30  # spotify-rust per-user playback poll interval (0 = poller disabled)

# --- Lemonic (vc-ts) ---
LEMONIC_API=https://api.lemonic.xyz  # Lemonic API base
LEMONIC_API_KEY=  # Lemonic key (optional — works unauthenticated first, key only adds a Bearer header)

# --- Navidrome / Soulseek (downloaders; slskd daemon in compose profile full) ---
NAVIDROME_URL=  # Navidrome server base URL
NAVIDROME_USER=  # Navidrome username
NAVIDROME_PASSWORD=  # Navidrome password (NOT NAVIDROME_PASS — that name was never read)
SLSKD_URL=http://slskd:5030  # slskd base URL (compose: http://slskd:5030; SLSKD_HOST is an accepted alias)
SLSKD_API_KEY=  # slskd web API key, 16-255 chars (empty = no auth header)
SLSKD_HOST=  # alias for SLSKD_URL (SLSKD_URL wins when both are set)
SLSKD_API_TIMEOUT_SECS=30  # per-request timeout for the slskd API
SLSKD_SEARCH_MIN_INTERVAL_SECS=10  # search pacing (Soulseek bans search floods)
SLSKD_DOWNLOAD_DIR=  # where slskd writes downloads (default: $PARLAY_DL_DIR/.slskd-downloads)
SLSKD_STALL_SECS=120  # give up on a started-but-stalled transfer after this many seconds of no bytes (0 disables)
SLSKD_DOWNLOAD_TIMEOUT=900  # per-attempt queue+transfer cap, seconds
SLSKD_MAX_PEER_ATTEMPTS=3  # peer attempts per Soulseek download
SLSKD_SLOW_MIN_MBPS=0  # measured-speed floor in MB/s for peer selection (0 = disabled)
DEEZER_ARL=  # Deezer `arl` session cookie for full tracks; previews only without it (B2)
DEEZER_FORMAT=MP3_320  # Deezer format: MP3_128 | MP3_320 | FLAC (B2)

# --- NetEase (netease-go) ---
NETEASE_MUSIC_U=  # NetEase MUSIC_U login cookie for direct URLs (sent only to NetEase hosts, never the mirror); mirror fallback works without it (B3)

# --- Misc per-service ---
PARLAY_VOTE_THRESHOLD=3  # queue-rust: approvals needed before a track is queued
PARLAY_BOT_USERNAME=ParlayBot  # share-rust: bot username used in share links (t.me/<name>?start=share_<token>)
PARLAY_SPOTIFY_MAX_MATCH_SEC=1200  # downloaders: max YouTube match length for a Spotify track (20 min default; longer = refused, not downloaded)

# --- AI lyrics classifier (spotify-rust, Phase 5) ---
GEMINI_API_KEY=  # Gemini API key for the AI-lyrics classifier (user-chosen classifier; empty = classifier reports "cannot judge")
GEMINI_API_BASE=https://generativelanguage.googleapis.com  # Gemini API base
GEMINI_MODEL=gemini-2.0-flash  # Gemini model for classification

# --- Lyrics providers (spotify-rust; Genius -> Musixmatch -> LRCLib, B5) ---
GENIUS_ACCESS_TOKEN=  # Genius API token (public api.genius.com search + song-page scrape); LRCLib only without it
MUSIXMATCH_API_KEY=  # Musixmatch API key (matcher.lyrics.get); LRCLib only without it
