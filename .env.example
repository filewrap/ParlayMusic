# Parlay — copy to .env and fill in locally. Never commit .env.
# Telegram
BOT_TOKEN=
API_ID=
API_HASH=
# Shared IPC token — same value in every service
PARLAY_TOKEN=
# Data
MONGO_URI=mongodb://localhost:27017/parlay
REDIS_URL=redis://localhost:6379/0
# VC engine selection: go | ts | rust ; profile: low-ram | high-perf
VC_ENGINE=go
VC_PROFILE=low-ram
# Optional services (leave blank to disable)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
LEMONIC_API_KEY=
NAVIDROME_URL=
NAVIDROME_USER=
NAVIDROME_PASS=
