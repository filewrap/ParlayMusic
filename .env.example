# Parlay — copy to .env and fill in locally. Never commit .env.
# Every variable the live code reads, one line each. Verified by
# grepping services/backend-go + services/core-cpp/src, 2026-11-03,
# pre-Phase 4 wiring audit (Worker B). The deleted 12-service topology
# is gone: there is no Mongo/Redis, no per-service HTTP URL, no voice
# bridge. See "REMOVED" at the bottom for names that no longer belong
# here. Secrets are NEVER committed; values below are defaults/empty.
#
# Two config surfaces: parlay.toml (operational values — rate limits,
# timeouts, quality, limits, plus the backend's [backend] table; see
# parlay.toml.example) and this file (credentials, endpoints, paths).
# A PARLAY_* env var always wins over parlay.toml.

# --- Telegram bot (core-cpp, required) ---
BOT_TOKEN=
API_ID=  # Telegram API id (Bot API + MTProto; TD_API_ID falls back to this)
API_HASH=  # Telegram API hash (TD_API_HASH falls back to this)
OWNER_ID=  # Telegram user id of the owner (permission model)
SUDO_IDS=  # comma-separated sudo user ids
LOGGER_ID=  # log channel/chat id (0 = unset)
PARLAY_ALLOW_CHATS=  # comma-separated chat ids the bot serves (empty = all)
PARLAY_BLOCK_CHATS=  # comma-separated chat ids the bot refuses
ASSISTANT_IDS=  # comma-separated assistant/userbot account ids
SUPPORT_CHAT=  # support chat shown in /help (e.g. @parlay_support)
PARLAY_TOKEN=  # shared IPC auth token (core HTTP API; the UDS socket itself is guarded by filesystem perms, 0600 in a 0700 data dir)

# --- Config file, data dir, IPC socket (both processes) ---
PARLAY_CONFIG=  # explicit parlay.toml path. Search order when unset: ./parlay.toml, <exeDir>/parlay.toml, <exeDir>/../parlay.toml (same on both sides)
PARLAY_DATA_DIR=data  # data dir for BOTH processes: backend store data/parlay.db (bbolt, 0600) + core file state data/state.json + TDLib sessions below. Empty = unset (falls back to "data")
PARLAY_UDS_PATH=  # UDS socket override. Default on BOTH sides: <PARLAY_DATA_DIR>/parlay-backend.sock (backend listens, core connects)
PORT=8080  # core HTTP port (GUI /api surface, Phase 6 A2). NOTE: changing PORT does NOT move the Spotify redirect below — that URI is fixed by the Spotify app registration
PARLAY_LOG_FILE=  # core-cpp: optional stdout/stderr tee file (empty = off)
TELEGRAM_API_BASE=https://api.telegram.org  # Bot API base (override for a local Bot API server)

# --- parlay.toml env overrides (PARLAY_* wins over the file) ---
# Defaults below match parlay.toml.example exactly. Only set these to
# override the file; normally leave them unset and edit parlay.toml.
PARLAY_RATE_LIMIT_CHAT_CAPACITY=5  # per-chat token bucket burst (default 5 @ 1.0/s)
PARLAY_RATE_LIMIT_CHAT_REFILL_PER_SEC=1.0
PARLAY_RATE_LIMIT_USER_CAPACITY=3  # per-user token bucket burst (default 3 @ 1.0/s)
PARLAY_RATE_LIMIT_USER_REFILL_PER_SEC=1.0
PARLAY_TIMEOUT_RESOLVE_MS=30000  # track/stream resolution budget
PARLAY_TIMEOUT_JOIN_MS=30000  # voice-chat join budget
PARLAY_TIMEOUT_IPC_CMD_MS=10000  # generic IPC command budget
PARLAY_TIMEOUT_DOWNLOAD_MS=300000  # file download budget
PARLAY_TIMEOUT_HEALTHZ_MS=5000  # backend health-probe budget
PARLAY_VOICE_PROFILE=standard_192k  # ultra_320k | high_256k | standard_192k
PARLAY_SOURCE_LADDER=navidrome,soulseek,deezer,netease,jiosaavn,youtube,spotify,tiktok,radio  # comma-separated
PARLAY_RESAMPLER_QUALITY=sinc_256  # sinc_256 | sinc_128 | fast
PARLAY_MAX_DURATION_MINUTES=60  # longest playable track, minutes
PARLAY_MAX_QUEUE_SIZE=20  # most queued tracks per chat
PARLAY_PREFETCH_LEAD_TIME_SEC=30  # resolve track N+1 this far before track N ends
PARLAY_URL_CACHE_TTL_SEC=120  # resolved URL cache TTL (CDN URLs live ~2 min)
# Legacy aliases, still honoured AFTER the PARLAY_* names above (deprecated):
DURATION_LIMIT=60  # legacy alias for PARLAY_MAX_DURATION_MINUTES
QUEUE_LIMIT=20  # legacy alias for PARLAY_MAX_QUEUE_SIZE

# --- TDLib voice (core-cpp; dual session, both dirs 0700) ---
TD_API_ID=  # TDLib api id (falls back to API_ID)
TD_API_HASH=  # TDLib api hash (falls back to API_HASH)
TD_SESSION_DIR=  # assistant session dir (default: <PARLAY_DATA_DIR>/tdlib, 0700)
TD_BOT_SESSION_DIR=  # bot session dir (default: <PARLAY_DATA_DIR>/tdlib-bot, 0700)
TD_PHONE=  # TDLib first-auth phone, only if a fresh login is needed
TD_CODE=  # TDLib first-auth login code
TD_PASSWORD=  # TDLib first-auth 2FA password
TD_EMAIL=  # TDLib first-auth email, only if the account uses email login
TD_EMAIL_CODE=  # TDLib email login code
TD_FIRST_NAME=  # TDLib first-time registration first name (required if registering)
TD_LAST_NAME=  # TDLib first-time registration last name (optional)
TD_QR=1  # set to 1 to use QR-code login instead of phone+code on first auth
VOICE_RTP_SINK=  # host:port UDP sink for the Opus/RTP pipeline proof (empty = file only)

# --- UI links/images (core-cpp; empty = button/row omitted) ---
START_IMG=  # optional /start photo URL
PING_IMG=  # optional /ping photo URL
PARLAY_UPDATES_URL=  # updates channel URL
PARLAY_SUPPORT_URL=  # support URL (falls back to https://t.me/<SUPPORT_CHAT>)
PARLAY_SOURCE_URL=  # repo URL, e.g. https://github.com/filewrap/ParlayMusic

# --- Spotify (backend-go; app token + per-user OAuth) ---
SPOTIFY_CLIENT_ID=  # Spotify app client id (metadata, collections, per-user OAuth)
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8080/callback  # per-user OAuth redirect — Spotify rejects "localhost"; must match the registered URI exactly. Independent of PORT above: changing PORT does not move this URI
PARLAY_SPOTIFY_OAUTH_KEY=  # base64 of 32 random bytes; AES-256-GCM key for per-user OAuth tokens. Unset = a key is generated once and stored at <PARLAY_DATA_DIR>/spotify-user-key (0600)
SPOTIFY_ACCOUNTS_URL=https://accounts.spotify.com  # Spotify accounts base (override for tests)
SPOTIFY_API_BASE=https://api.spotify.com  # Spotify Web API base (override for tests)
SPOTIFY_POLL_INTERVAL_SECS=30  # per-user playback poll interval (0 = poller disabled)

# --- Resolvers: Navidrome / Soulseek / Deezer / NetEase (backend-go) ---
# These are read DIRECTLY from the environment by the resolvers; the
# same names in parlay.toml [backend] are parsed but currently ignored
# (see parlay.toml.example). Env is the live path.
NAVIDROME_URL=  # Navidrome server base URL
NAVIDROME_USER=  # Navidrome username
NAVIDROME_PASSWORD=  # Navidrome password (note: PASSWORD, not PASS)
SLSKD_URL=http://127.0.0.1:5030  # slskd base URL (optional Soulseek daemon; default port 5030)
SLSKD_HOST=  # alias for SLSKD_URL (SLSKD_URL wins when both are set)
SLSKD_API_KEY=  # slskd API key (sent as X-API-Key)
SLSKD_API_TIMEOUT_SECS=30  # per-request timeout for the slskd API
SLSKD_DOWNLOAD_TIMEOUT=900  # per-attempt queue+transfer cap, seconds
SLSKD_DOWNLOAD_DIR=  # where slskd writes downloads (default: <PARLAY_DATA_DIR>/soulseek)
SLSKD_STALL_SECS=120  # give up on a started-but-stalled transfer after this many seconds of no bytes (0 disables)
DEEZER_ARL=  # Deezer `arl` session cookie for full tracks; previews only without it
NETEASE_MUSIC_U=  # NetEase MUSIC_U login cookie for direct URLs (sent only to NetEase hosts, never the mirror); mirror fallback works without it
LEMONIC_API=https://api.lemonic.xyz  # Lemonic API base (JioSaavn)
LEMONIC_API_KEY=
MAX_BIT_DEPTH=24  # Soulseek scorer: quality cap in bits (0 disables that axis)
MAX_SAMPLE_RATE_HZ=96000  # Soulseek scorer: quality cap in Hz (0 disables that axis)

# --- yt-dlp daemon (backend-go; persistent process, no per-call fork) ---
# The daemon is scripts/yt_dlp_worker.py run by the venv python at
# scripts/yt-dlp-venv/bin/python (found by walking up from the working
# directory). Set these two vars when running from outside the repo
# tree; the defaults below are what the code looks for.
PARLAY_YTDLP_PYTHON=  # python with yt_dlp importable (default: scripts/yt-dlp-venv/bin/python, else python3)
PARLAY_YTDLP_WORKER=  # worker script path (default: scripts/yt_dlp_worker.py, found by walking up from the working directory)

# --- AI classifier + lyrics (backend-go) ---
GEMINI_API_KEY=  # Gemini API key (AI lyrics classifier)
GEMINI_API_BASE=https://generativelanguage.googleapis.com  # Gemini API base
GEMINI_MODEL=gemini-2.0-flash  # Gemini model for classification
GENIUS_ACCESS_TOKEN=  # Genius lyrics (fallback chain: Genius -> Musixmatch -> LRCLib)
MUSIXMATCH_API_KEY=  # Musixmatch lyrics

# --- Music recognition (backend-go; AudD, free tier) ---
AUDD_API_TOKEN=  # AudD API token for audio.recognize (empty = action answers an honest 502)
AUDD_API_BASE=https://api.audd.io  # AudD API base (override for tests only; production is always https://api.audd.io)

# --- Misc per-service (backend-go) ---
TELEGRAM_BOT_USERNAME=  # bot username used in share links (t.me/<name>?start=share_<token>)
PARLAY_VOTE_THRESHOLD=3  # queue.vote: approvals needed before a track is queued (minimum 1)
PARLAY_LIVE_TEST=  # set to 1 to run live (network) tests; offline tests run by default (test-only)

# --- REMOVED (do not set — these names no longer configure anything) ---
# Deleted with the 12-service HTTP mesh / Mongo+Redis store (locked
# architecture, FINAL-ARCHITECTURE.md; Phase 3). Some are still parsed
# by config.cpp/config.go pending Worker C removal of the dead code
# that reads them (see phase3/wiring-audit-b-config.md §5) — setting
# them has no effect on the locked 2-process runtime, and MONGO_URI /
# REDIS_URL must NOT be set: the core still tries them first when
# present and would split state away from the bbolt store.
#   MONGO_URI REDIS_URL
#   VC_GO_URL VC_TS_URL VC_RUST_URL FX_URL SHARE_URL QUEUE_URL
#   SPOTIFY_URL RADIO_URL DL_URL DOWNLOADERS_URL NETEASE_URL CORE_URL
#   PARLAY_DL_DIR PARLAY_VOICE_PYTHON VC_PROFILE YT_DLP DEEZER_FORMAT
#   SLSKD_SEARCH_MIN_INTERVAL_SECS SLSKD_MAX_PEER_ATTEMPTS
#   SLSKD_SLOW_MIN_MBPS PARLAY_SPOTIFY_MAX_MATCH_SEC PARLAY_BOT_USERNAME
# Parsed-but-unplugged (read into config, never consumed by any
# resolver — set the live name instead):
#   NAVIDROME_PASS (use NAVIDROME_PASSWORD) SLSKD_USER SLSKD_PASS
#   YTDLP_PATH (use PARLAY_YTDLP_PYTHON / PARLAY_YTDLP_WORKER)
# Runtime library overrides removed (in-flight Worker C change, seen
# in the working tree 2026-11-03 ~18:30 IST): both libraries are now
# linked at build time, so the env vars no longer select a library.
# libtdjson's path is a CMake variable instead (-DTDJSON_LIB=...).
#   TDJSON_LIB NTGCALLS_LIB
