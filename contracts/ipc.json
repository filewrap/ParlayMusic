    "spotify.auth": {
      "from": "rustify src/spotify/auth.rs + Manager token_refresh + tick/user.rs check",
      "method": "POST /v1/spotify/auth",
      "request": {
        "action": "login|callback|refresh|revoke",
        "user_id": "integer",
        "code": "string, callback only"
      },
      "response": {
        "login": {
          "authorized": "boolean",
          "user_id": "integer",
          "authorize_url": "string",
          "note": "complete the URL in a browser, then POST action:callback with the returned code"
        },
        "callback": {
          "authorized": "boolean",
          "user_id": "integer",
          "expires_at": "integer"
        },
        "refresh": {
          "authorized": "boolean",
          "user_id": "integer",
          "expires_at": "integer"
        },
        "revoke": {
          "authorized": "boolean",
          "user_id": "integer",
          "was_authorized": "boolean"
        }
      },
      "errors": {
        "503 engine_unavailable": "per-user Spotify auth needs SPOTIFY_CLIENT_ID and SPOTIFY_CLIENT_SECRET",
        "404 not_found": "no stored token for this user (refresh without login)",
        "401 unauthorized": "refresh token rejected by Spotify (invalid_grant); token dropped, login again",
        "502 download_failed": "authorization code exchange failed (bad/expired code, or Spotify rejected the client)"
      },
      "service": "spotify-rust"
    },
