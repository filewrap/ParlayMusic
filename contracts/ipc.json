{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "actions": {
    "chat.settings": {
      "from": "UI_INVENTORY.md §29 IPC-6 (Phase 9)",
      "method": "GET /v1/chat/settings?chat_id= | POST /v1/chat/settings",
      "request": {
        "chat_id": "ChatId",
        "key": "string (POST only: admin_mode|play_mode|cmd_delete|clean_mode|clean_delay_min|thumbnails|autoplay|autoplay_lang|autoplay_mood|silent_mode|auto_delete|auto_delete_min|language|paginate_purge_old|chat_music_download)",
        "value": "string|boolean|integer (POST only)"
      },
      "response": {
        "chat_id": "ChatId",
        "settings": {
          "admin_mode": "integer",
          "play_mode": "string",
          "cmd_delete": "boolean",
          "clean_mode": "boolean",
          "clean_delay_min": "integer",
          "thumbnails": "boolean",
          "autoplay": "boolean",
          "autoplay_lang": "string",
          "autoplay_mood": "string",
          "silent_mode": "boolean",
          "auto_delete": "boolean",
          "auto_delete_min": "integer",
          "language": "string",
          "paginate_purge_old": "boolean",
          "chat_music_download": "boolean"
        }
      },
      "service": "core-cpp"
    },
    "download.deezer": {
      "method": "POST /v1/download/deezer",
      "request": {
        "query": "string",
        "requested_by": "UserId"
      },
      "response": {
        "file_path": "string",
        "track": "Track",
        "run_id": "string"
      },
      "service": "downloaders"
    },
    "download.navidrome": {
      "from": "music-bot-navidrome src/navidrome.py, src/soulseek/*",
      "method": "POST /v1/download/navidrome",
      "request": {
        "requested_by": "UserId",
        "url": "string"
      },
      "response": {
        "imported": "boolean",
        "track": "Track",
        "run_id": "string"
      },
      "service": "downloaders"
    },
    "download.progress": {
      "from": "UI_INVENTORY.md §29 IPC-4 (Phase 9); downloaders server.py",
      "method": "GET /v1/download/progress?run_id=",
      "request": {
        "run_id": "string"
      },
      "response": {
        "run_id": "string",
        "percentage": "number",
        "done_bytes": "integer",
        "total_bytes": "integer|null",
        "speed_bytes_per_sec": "number",
        "eta_sec": "integer|null",
        "elapsed_sec": "number",
        "phase": "searching|downloading|uploading|done|failed",
        "per_track": [
          {
            "title": "string",
            "state": "string",
            "pct": "number",
            "peer": "string|null",
            "reason": "string|null"
          }
        ],
        "lossy_available": "boolean",
        "lossy_summary": "string|null"
      },
      "service": "downloaders"
    },
    "download.soulseek": {
      "from": "Navidrome music-bot src/soulseek/{client,downloader,matcher,scorer}, via slskd",
      "method": "POST /v1/download/soulseek",
      "request": {
        "query": "string",
        "artist": "string",
        "title": "string",
        "duration_sec": "integer",
        "accept_lossy": "boolean",
        "album": {
          "artist": "string",
          "title": "string",
          "tracks": "array of {title, artist, duration_sec}"
        },
        "requested_by": "integer"
      },
      "response": {
        "file_path": "string",
        "track": "Track",
        "oversize": "boolean",
        "size_bytes": "integer",
        "peer": "string",
        "format": "string",
        "count": "integer, album only",
        "total": "integer, album only",
        "failed": "array of [title, reason], album only",
        "album_dir": "string, album only",
        "source": "soulseek",
        "run_id": "string"
      },
      "errors": {
        "engine_unavailable": "slskd unreachable at SLSKD_URL, or search could not run (e.g. slskd not logged in)",
        "download_failed": "search ran but found nothing usable (honest reason in message)"
      },
      "service": "downloaders"
    },
    "download.spotify": {
      "from": "Spotify-Loader bot.py",
      "method": "POST /v1/download/spotify",
      "request": {
        "requested_by": "UserId",
        "url": "string"
      },
      "response": {
        "file_path": "string",
        "track": "Track",
        "run_id": "string"
      },
      "service": "downloaders"
    },
    "download.spotify_playlist": {
      "from": "Spotify-Loader bot.py",
      "method": "POST /v1/download/spotify-playlist",
      "request": {
        "mode": "zip|files",
        "requested_by": "UserId",
        "url": "string"
      },
      "response": {
        "count": "integer",
        "file_path": "string",
        "file_paths": [
          "string"
        ],
        "run_id": "string"
      },
      "service": "downloaders"
    },
    "download.tiktok": {
      "from": "telegram-music-bot-rust main.rs",
      "method": "POST /v1/download/tiktok",
      "request": {
        "requested_by": "UserId",
        "url": "string"
      },
      "response": {
        "file_path": "string",
        "track": "Track",
        "run_id": "string"
      },
      "service": "downloaders"
    },
    "download.youtube": {
      "from": "sanila Telegram-Song-Downloader-Bot bot.py",
      "method": "POST /v1/download/youtube",
      "request": {
        "query": "string",
        "requested_by": "UserId"
      },
      "response": {
        "file_path": "string",
        "oversize": "boolean",
        "size_bytes": "integer",
        "track": "Track",
        "run_id": "string"
      },
      "service": "downloaders"
    },
    "fx.apply": {
      "from": "telegram-music-bot-rust main.rs (FFmpeg filter chains)",
      "method": "POST /v1/fx",
      "request": {
        "effect": "slow-reverb|nightcore|bass-boost|8d|original",
        "input_path": "string",
        "requested_by": "UserId"
      },
      "response": {
