      "from": "lemonic modules/lemonic.ts, Music163bot-Go handlers_search.go, remix handlers/search.ts",
      "method": "POST /v1/search",
      "request": {
        "limit": "integer",
        "query": "string",
        "source": "youtube|spotify|netease|deezer|lemonic|all"
      },
      "response": {
        "results": [
          "Track"
        ]
      },
      "service": "vc-ts | downloaders | netease-go"
    },
    "share.create": {
      "from": "feel-me src/main.rs, src/models.rs",
      "method": "POST /v1/share",
