    "spotify.collection": {
      "from": "Spotify Web API (client credentials) + Spotify-Loader bot.py",
      "method": "POST /v1/spotify/collection",
      "request": {
        "url": "string (open.spotify.com/<album|playlist|artist>/<id> or spotify:<kind>:<id>)"
      },
      "response": {
        "api": "string",
        "kind": "string",
        "name": "string",
        "tracks": [
          "Track"
        ],
        "truncated": "boolean"
      },
      "service": "spotify-rust | downloaders"
    },
    "spotify.status": {
      "method": "GET /v1/spotify/status",
      "request": {},
      "response": {
        "api": "string",
        "credentials_configured": "boolean",
        "token_cached": "boolean"
      },
      "service": "spotify-rust"
    },
    "vc.volume": {
      "from": "vc-ts src/main.js volume control",
      "method": "POST /v1/volume",
      "request": {
        "chat_id": "ChatId",
        "volume": "integer 0..200"
      },
      "response": {
        "now_playing": "NowPlaying"
      },
      "service": "vc-ts"
    }
  },
  "description": "Single contract for all Parlay services. HTTP + JSON. Every service: POST /v1/<action> with header X-Parlay-Token: $PARLAY_TOKEN. Health: GET /healthz -> {ok, service}. Error envelope everywhere: {ok:false, error:{code, message}}. Success: {ok:true, data:{...}}.",
  "notes": [
    "Files over the 50 MB Bot API cap: download.* returns oversize=true; the core queues them for a later MTProto pass instead of failing.",
    "New actions are added here first, then in the service, then in the core handler.",
    "v0.3.0 (Phase 9): IPC-1 vc.now_playing UI fields, IPC-2 vc.progress, IPC-3 search Track fields, IPC-4 download.progress, IPC-5 lyrics fields, IPC-6 chat.settings, IPC-7 spotify.details/analyze. download.spotify_playlist gains file_paths (files mode). radio.status response corrected to the radio-js shape.",
    "v0.3.1 (Phase 9 gaps): search.inline request gains optional chat_id (np/s/l modes only — the core passes the chat the inline user is playing in; without it those modes return empty results); netease.lyrics response gains lrc_path (the .lrc file the service wrote under the download dir, empty string when the write fails); every download.* POST response gains run_id (12-hex progress-run id — the core reads it from the response for the IPC-4 snapshot. Live polling DURING the transfer is still not possible: the downloaders POST blocks until the transfer completes, so the run_id is only known after the POST returns.)"
  ],
  "title": "Parlay IPC contract",
  "transport": {
    "auth_header": "X-Parlay-Token",
    "envelope_err": {
      "error": {
        "code": "string",
        "message": "string"
      },
      "ok": false
    },
    "envelope_ok": {
      "data": {},
      "ok": true
    },
    "error_codes": [
      "bad_request",
      "unauthorized",
      "not_found",
      "engine_unavailable",
      "download_failed",
      "rate_limited",
      "internal"
    ],
    "protocol": "HTTP/1.1 + JSON",
    "timeout_ms": 30000
  },
  "types": {
    "ChatId": {
      "description": "Telegram chat id (negative for groups)",
      "type": "integer"
    },
    "NowPlaying": {
      "properties": {
        "autoplay": {
          "description": "autoplay on: a related track is picked when the queue drains",
          "type": "boolean"
        },
        "chat_id": {
          "$ref": "#/types/ChatId"
        },
        "engine": {
          "enum": [
            "go",
            "ts",
            "rust"
          ],
          "type": "string"
        },
        "loop": {
          "description": "remaining replays of the current track, 0 = off (range 0-10)",
          "type": "integer"
        },
        "paused": {
          "type": "boolean"
        },
        "position_sec": {
          "type": "integer"
        },
        "queue": {
          "items": {
            "$ref": "#/types/QueueItem"
          },
          "type": "array"
        },
        "shuffle": {
          "description": "shuffle on: the next track is picked at random from the queue",
          "type": "boolean"
        },
        "stream_url": {
          "description": "resolved direct audio URL for the current track (e.g. yt-dlp bestaudio), when the engine knows one; absent otherwise",
          "type": "string"
        },
        "track": {
          "$ref": "#/types/Track"
        },
        "volume": {
          "type": "integer"
        },
        "is_paused": {
          "type": "boolean",
          "description": "IPC-1: canonical UI field; true when playback is paused (engines may also report paused)"
        },
        "is_muted": {
          "type": "boolean",
          "description": "IPC-1: canonical UI field; true when the voice chat is muted"
        },
        "loop_count": {
          "type": "integer",
          "description": "IPC-1: canonical UI field; remaining replays of the current track, 0 = off (engines may also report loop)"
        },
        "speed": {
          "type": "number",
          "description": "IPC-1: canonical UI field; playback speed multiplier, 1.0 = normal"
        },
        "autoplay_enabled": {
          "type": "boolean",
          "description": "IPC-1: canonical UI field; autoplay on (engines may also report autoplay)"
        }
      },
      "type": "object"
    },
    "QueueItem": {
      "properties": {
        "position": {
          "type": "integer"
        },
        "requested_by": {
          "$ref": "#/types/UserId"
        },
        "track": {
          "$ref": "#/types/Track"
        }
      },
      "required": [
        "track",
        "requested_by"
      ],
      "type": "object"
    },
    "Track": {
      "properties": {
        "artist": {
          "type": "string"
        },
        "duration_sec": {
          "type": "integer"
        },
        "id": {
          "type": "string"
        },
        "source": {
          "enum": [
            "youtube",
            "spotify",
            "netease",
            "deezer",
            "jiosaavn",
            "soundcloud",
            "radio",
            "file",
            "lemonic"
          ],
          "type": "string"
        },
        "stream_url": {
          "description": "resolved direct audio URL (e.g. yt-dlp bestaudio), when the resolving service knows one; absent otherwise",
          "type": "string"
        },
        "thumbnail": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "duration_str": {
          "type": "string",
          "description": "IPC-3: pre-formatted duration (e.g. 3:42), when the resolver knows one"
        },
        "views": {
          "type": [
            "integer",
            "null"
          ],
          "description": "IPC-3: view count, when the resolver knows one"
        },
        "uploader": {
          "type": [
            "string",
            "null"
          ],
          "description": "IPC-3: uploader/channel name, when the resolver knows one"
        },
        "upload_time": {
          "type": [
            "string",
            "null"
          ],
          "description": "IPC-3: upload date/time as the resolver reports it"
        },
        "is_live": {
          "type": "boolean",
          "description": "IPC-3: true for a live stream"
        }
      },
      "required": [
        "id",
        "title",
        "source"
      ],
      "type": "object"
    },
    "UserId": {
      "description": "Telegram user id",
      "type": "integer"
    }
  },
  "version": "0.3.1"
}
