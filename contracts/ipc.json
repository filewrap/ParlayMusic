    "quality.get": {
      "from": "Opus quality surface (2026-11-05): effective-config read for /quality and the settings-panel quality section",
      "method": "UDS quality.get",
      "request": {
        "chat_id": "ChatId"
      },
      "response": {
        "chat_id": "ChatId",
        "effective": {
          "bitrate_bps": "integer (effective Opus bitrate)",
          "frame_ms": "integer (effective Opus frame size, one of 10, 20, 40, 60)",
          "complexity": "integer (effective Opus complexity, 0..10)",
          "vbr": "boolean",
          "fec": "boolean",
          "dtx": "boolean",
          "max_playback_rate_hz": "integer (always 48000)"
        },
        "sources": "object (winning level per field: store|config|profile|default; keys bitrate_bps, frame_ms, complexity, vbr, fec, dtx)",
        "library": "object (same shape as effective: the library's currently stored config, what the next encoder will actually use)",
        "active_call": "boolean (the chat has a live call)",
        "applies_on": "string (always \"next join\": settings apply to encoders created after the call, never mid-call)"
      },
      "service": "backend-go:quality"
    },
