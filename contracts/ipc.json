{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "actions": {
    "audio.recognize": {
      "from": "phase3/actions-inventory.md §9-E4 (OD-3); provider AudD per OD-10 (user decision 2026-11-03)",
      "method": "UDS audio.recognize",
      "request": {
        "file_path": "string (path under the data dir)",
        "file_id": "string (Telegram file id, optional)"
      },
      "response": {
        "recognized": "boolean",
        "track": "Track (when recognized)",
        "name": "string",
        "artists": ["string"],
        "album": "string",
        "source": "string (spotify|deezer|audd)"
      },
      "service": "backend-go:recognize",
      "ported": "Phase 3 Wave 2 (OD-3) — env-gated on AUDD_API_TOKEN, honest 502 while unconfigured"
    },
    "cache.clear": {
      "from": "phase3/actions-inventory.md §9-E7 (OD-3)",
      "method": "UDS cache.clear",
      "request": {
        "scope": "track|all",
        "name": "string (track scope: cached track name)"
      },
      "response": {
        "cleared": "boolean",
        "names": ["string"]
      },
      "service": "backend-go:library",
      "ported": "Phase 3 Wave 2 (OD-3)"
    },
    "chat.settings": {
      "from": "UI_INVENTORY.md §29 IPC-6 (Phase 9)",
      "method": "UDS chat.settings",
      "request": {
        "chat_id": "ChatId",
        "key": "string (set only: admin_mode|play_mode|cmd_delete|clean_mode|clean_delay_min|thumbnails|autoplay|autoplay_lang|autoplay_mood|silent_mode|auto_delete|auto_delete_min|language|paginate_purge_old|chat_music_download|quality_bitrate_bps|quality_frame_ms|quality_complexity|quality_vbr|quality_fec|quality_dtx)",
        "value": "string|boolean|integer|null (set only; null on a quality_* key clears the per-chat override)"
      },
      "response": {
        "chat_id": "ChatId",
        "settings": {
          "admin_mode": "integer",
          "play_mode": "string (everyone|admins; default everyone)",
          "cmd_delete": "boolean",
          "clean_mode": "boolean",
          "clean_delay_min": "integer",
          "thumbnails": "boolean",
          "autoplay": "boolean",
          "autoplay_lang": "string (default \"\" — any language)",
          "autoplay_mood": "string",
          "silent_mode": "boolean",
          "auto_delete": "boolean",
          "auto_delete_min": "integer",
          "language": "string",
          "paginate_purge_old": "boolean",
          "chat_music_download": "boolean",
          "quality_bitrate_bps": "integer|null (per-chat Opus bitrate override, 6000..510000; null = no override, fall through to parlay.toml [quality])",
          "quality_frame_ms": "integer|null (per-chat Opus frame-size override, one of 10, 20, 40, 60; null = no override)",
          "quality_complexity": "integer|null (per-chat Opus complexity override, 0..10; null = no override)",
          "quality_vbr": "boolean|null (per-chat Opus VBR override; null = no override)",
          "quality_fec": "boolean|null (per-chat Opus FEC override; null = no override)",
          "quality_dtx": "boolean|null (per-chat Opus DTX override; null = no override)"
        }
      },
      "service": "backend-go:settings"
    },
    "download.cancel": {
      "from": "phase3/actions-inventory.md §9-E1 (OD-3)",
      "method": "UDS download.cancel",
      "request": {
        "run_id": "string"
      },
      "response": {
        "cancelled": "boolean",
        "run_id": "string",
        "phase": "string"
      },
      "service": "backend-go:download",
      "ported": "Phase 3 Wave 2 (OD-3)"
    },
    "download.cancel_chat": {
      "from": "queue-port Tier 3 item 25 (Parvati DL_CANCELS, ported onto the run-context mechanism)",
      "method": "UDS download.cancel_chat",
      "request": {
        "chat_id": "ChatId"
      },
      "response": {
        "cancelled": "boolean (true when at least one run was live)",
        "chat_id": "ChatId",
        "run_ids": ["string (backend ids of the cancelled runs)"]
      },
      "service": "backend-go:download"
    },
    "download.deezer": {
      "method": "UDS download.deezer",
      "request": {
        "query": "string",
        "requested_by": "UserId"
      },
      "response": {
        "file_path": "string",
        "track": "Track",
        "run_id": "string"
      },
      "service": "backend-go:download"
    },
    "download.navidrome": {
      "from": "music-bot-navidrome src/navidrome.py, src/soulseek/*",
      "method": "UDS download.navidrome",
      "request": {
        "requested_by": "UserId",
        "url": "string"
      },
      "response": {
