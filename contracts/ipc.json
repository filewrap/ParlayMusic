      "from": "phase3/actions-inventory.md §9-E9 (OD-3)",
      "method": "UDS download.prefs",
      "request": {
        "user_id": "UserId",
        "format": "string (set only: mp3|m4a|flac|opus|ogg|wav)",
        "use_youtube": "boolean (set only)",
        "path_template": "string (set only, must contain {ext})"
      },
      "response": {
        "user_id": "UserId",
        "format": "string",
        "use_youtube": "boolean",
        "path_template": "string"
      },
      "service": "backend-go:download",
      "ported": "Phase 3 Wave 2 (OD-3)"
    },
    "download.progress": {
      "from": "UI_INVENTORY.md §29 IPC-4 (Phase 9)",
      "method": "UDS download.progress",
      "request": {
        "run_id": "string"
      },
      "response": {
        "run_id": "string",
        "percentage": "number",
        "done_bytes": "integer",
        "total_bytes": "integer|null",
        "speed_bytes_per_sec": "number",
        "eta_sec": "integer|null",
        "elapsed_sec": "number",
        "phase": "searching|downloading|uploading|done|failed",
        "per_track": [
          {
            "title": "string",
            "state": "string",
            "pct": "number",
            "peer": "string|null",
            "reason": "string|null"
          }
        ],
        "lossy_available": "boolean",
        "lossy_summary": "string|null"
      },
      "service": "backend-go:download"
    },
    "download.soulseek": {
      "from": "Navidrome music-bot src/soulseek/{client,downloader,matcher,scorer}, via slskd",
      "method": "UDS download.soulseek",
      "request": {
        "query": "string",
        "artist": "string",
        "title": "string",
        "duration_sec": "integer",
        "accept_lossy": "boolean",
        "album": {
          "artist": "string",
          "title": "string",
          "tracks": "array of {title, artist, duration_sec}"
        },
        "requested_by": "integer"
      },
      "response": {
        "file_path": "string",
        "track": "Track",
        "oversize": "boolean",
        "size_bytes": "integer",
        "peer": "string",
        "format": "string",
        "count": "integer, album only",
        "total": "integer, album only",
        "failed": "array of [title, reason], album only",
        "album_dir": "string, album only",
        "source": "soulseek",
        "run_id": "string"
      },
      "errors": {
        "engine_unavailable": "slskd unreachable at SLSKD_URL, or search could not run (e.g. slskd not logged in)",
        "download_failed": "search ran but found nothing usable (honest reason in message)"
      },
      "service": "backend-go:download"
    },
    "download.spotify": {
      "from": "Spotify-Loader bot.py",
      "method": "UDS download.spotify",
      "request": {
        "requested_by": "UserId",
        "url": "string"
      },
      "response": {
        "file_path": "string",
        "track": "Track",
        "run_id": "string"
      },
      "service": "backend-go:download"
    },
    "download.spotify_playlist": {
      "from": "Spotify-Loader bot.py",
      "method": "UDS download.spotify_playlist",
      "request": {
        "mode": "zip|files",
        "requested_by": "UserId",
        "url": "string"
      },
      "response": {
        "count": "integer",
        "file_path": "string",
        "file_paths": [
          "string"
        ],
        "run_id": "string"
      },
