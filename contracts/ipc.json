    },
    "spotify.analyze": {
      "from": "UI_INVENTORY.md §29 IPC-7 (Phase 9)",
      "method": "POST /v1/spotify/analyze",
      "request": {
        "user_id": "integer",
        "track_id": "string"
      },
      "response": {
        "analysis": "string",
        "profane_words": [
          "string"
        ]
      },
      "service": "spotify-rust"
    },
    "spotify.details": {
      "from": "UI_INVENTORY.md §29 IPC-7 (Phase 9)",
      "method": "GET /v1/spotify/details?user_id=&track_id=",
      "request": {
        "user_id": "UserId",
        "track_id": "string"
      },
      "response": {
        "track": "Track",
        "features": {
          "key": "string",
          "modality": "integer",
          "tempo_bpm": "number",
          "acousticness": "number",
          "danceability": "number",
          "energy": "number",
          "instrumentalness": "number",
          "liveness": "number",
          "speechiness": "number",
          "valence": "number"
        },
        "genres": [
          "string"
        ],
        "disliked_by": [
          "UserId"
        ],
        "ignored_by": [
          "UserId"
        ],
        "profanity": "string|null",
        "language": "string|null",
        "lyrics": "string|null",
        "lyrics_link": "string|null"
      },
      "service": "spotify-rust"
    },
    "spotify.auth": {
      "from": "rustify src/spotify/auth.rs + Manager token_refresh + tick/user.rs check",
      "method": "POST /v1/spotify/auth",
      "request": {
        "action": "login|callback|refresh|revoke",
        "user_id": "integer",
        "code": "string, callback only"
      },
      "response": {
        "login": {
          "authorized": "boolean",
          "user_id": "integer",
          "authorize_url": "string",
          "note": "complete the URL in a browser, then POST action:callback with the returned code"
        },
        "callback": {
          "authorized": "boolean",
          "user_id": "integer",
          "expires_at": "integer"
        },
        "refresh": {
          "authorized": "boolean",
          "user_id": "integer",
          "expires_at": "integer"
        },
        "revoke": {
          "authorized": "boolean",
          "user_id": "integer",
          "was_authorized": "boolean"
        }
      },
      "errors": {
        "503 engine_unavailable": "per-user Spotify auth needs SPOTIFY_CLIENT_ID and SPOTIFY_CLIENT_SECRET",
        "404 not_found": "no stored token for this user (refresh without login)",
        "401 unauthorized": "refresh token rejected by Spotify (invalid_grant); token dropped, login again",
        "502 download_failed": "authorization code exchange failed (bad/expired code, or Spotify rejected the client)"
      },
      "service": "spotify-rust"
    },
    "spotify.dislike": {
      "from": "rustify src/queue/* (disliked-track auto-skip)",
      "method": "POST /v1/spotify/dislike",
