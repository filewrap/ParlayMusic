  "description": "Single contract for all Parlay services. HTTP + JSON. Every service: POST /v1/<action> with header X-Parlay-Token: $PARLAY_TOKEN. Health: GET /healthz -> {ok, service}. Error envelope everywhere: {ok:false, error:{code, message}}. Success: {ok:true, data:{...}}.",
  "notes": [
    "Files over the 50 MB Bot API cap: download.* returns oversize=true; the core queues them for a later MTProto pass instead of failing.",
    "New actions are added here first, then in the service, then in the core handler."
  ],
  "title": "Parlay IPC contract",
  "transport": {
    "auth_header": "X-Parlay-Token",
    "envelope_err": {
      "error": {
        "code": "string",
        "message": "string"
      },
      "ok": false
    },
    "envelope_ok": {
      "data": {},
      "ok": true
    },
    "error_codes": [
      "bad_request",
      "unauthorized",
      "not_found",
      "engine_unavailable",
      "download_failed",
      "rate_limited",
      "internal"
    ],
    "protocol": "HTTP/1.1 + JSON",
    "timeout_ms": 30000
  },
  "types": {
    "ChatId": {
      "description": "Telegram chat id (negative for groups)",
      "type": "integer"
    },
    "NowPlaying": {
      "properties": {
        "autoplay": {
          "description": "autoplay on: a related track is picked when the queue drains",
          "type": "boolean"
        },
        "chat_id": {
          "$ref": "#/types/ChatId"
        },
        "engine": {
          "enum": [
            "go",
            "ts",
            "rust"
          ],
          "type": "string"
        },
        "loop": {
          "description": "remaining replays of the current track, 0 = off (range 0-10)",
          "type": "integer"
        },
        "paused": {
          "type": "boolean"
        },
        "position_sec": {
          "type": "integer"
        },
        "queue": {
          "items": {
            "$ref": "#/types/QueueItem"
          },
          "type": "array"
        },
        "shuffle": {
          "description": "shuffle on: the next track is picked at random from the queue",
          "type": "boolean"
        },
        "stream_url": {
          "description": "resolved direct audio URL for the current track (e.g. yt-dlp bestaudio), when the engine knows one; absent otherwise",
          "type": "string"
        },
        "track": {
          "$ref": "#/types/Track"
        },
        "volume": {
          "type": "integer"
        }
      },
      "type": "object"
    },
    "QueueItem": {
      "properties": {
        "position": {
          "type": "integer"
        },
        "requested_by": {
          "$ref": "#/types/UserId"
        },
        "track": {
          "$ref": "#/types/Track"
        }
      },
      "required": [
        "track",
        "requested_by"
      ],
      "type": "object"
    },
    "Track": {
      "properties": {
        "artist": {
          "type": "string"
        },
        "duration_sec": {
          "type": "integer"
        },
        "id": {
          "type": "string"
        },
        "source": {
          "enum": [
            "youtube",
            "spotify",
            "netease",
            "deezer",
            "jiosaavn",
            "soundcloud",
            "radio",
            "file",
            "lemonic"
          ],
          "type": "string"
        },
        "stream_url": {
          "description": "resolved direct audio URL (e.g. yt-dlp bestaudio), when the resolving service knows one; absent otherwise",
          "type": "string"
        },
        "thumbnail": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "url": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "source"
      ],
      "type": "object"
    },
    "UserId": {
      "description": "Telegram user id",
      "type": "integer"
    }
  },
  "version": "0.2.0"
}
