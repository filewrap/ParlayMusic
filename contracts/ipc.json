      "request": {
        "track_id": "string"
      },
      "response": {
        "lyrics": "string",
        "track_id": "string",
        "title": "string",
        "artist": "string",
        "source": "lrclib|netease|file-tag",
        "truncated": "boolean",
        "lrc_path": "string"
      },
      "service": "netease-go"
    },
    "netease.search": {
      "from": "Music163bot-Go handlers_search.go",
      "method": "POST /v1/netease/search",
      "request": {
        "query": "string"
      },
      "response": {
        "results": [
          "Track"
        ]
      },
      "service": "netease-go"
    },
    "queue.vote": {
      "from": "daslui src/spotify.rs",
      "method": "POST /v1/queue/vote",
      "request": {
        "track": "Track",
        "vote": "approve|decline",
