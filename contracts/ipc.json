{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "actions": {
    "download.deezer": {
      "method": "POST /v1/download/deezer",
      "request": {
        "query": "string",
        "requested_by": "UserId"
      },
      "response": {
        "file_path": "string",
        "track": "Track"
      },
      "service": "downloaders"
    },
    "download.navidrome": {
      "from": "music-bot-navidrome src/navidrome.py, src/soulseek/*",
      "method": "POST /v1/download/navidrome",
      "request": {
        "requested_by": "UserId",
        "url": "string"
      },
      "response": {
        "imported": "boolean",
        "track": "Track"
      },
      "service": "downloaders"
    },
    "download.soulseek": {
      "from": "Navidrome music-bot src/soulseek/{client,downloader,matcher,scorer}, via slskd",
      "method": "POST /v1/download/soulseek",
      "request": {
        "query": "string",
        "artist": "string",
        "title": "string",
        "duration_sec": "integer",
        "accept_lossy": "boolean",
        "album": {
          "artist": "string",
          "title": "string",
          "tracks": "array of {title, artist, duration_sec}"
        },
        "requested_by": "integer"
      },
      "response": {
        "file_path": "string",
        "track": "Track",
        "oversize": "boolean",
        "size_bytes": "integer",
        "peer": "string",
        "format": "string",
        "count": "integer, album only",
        "total": "integer, album only",
        "failed": "array of [title, reason], album only",
        "album_dir": "string, album only",
        "source": "soulseek"
      },
      "errors": {
        "engine_unavailable": "slskd unreachable at SLSKD_URL, or search could not run (e.g. slskd not logged in)",
        "download_failed": "search ran but found nothing usable (honest reason in message)"
      },
      "service": "downloaders"
    },
    "download.spotify": {
